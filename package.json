{
  "name": "aetio-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "ts-node-dev --env-file=.env --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "npm i && npm run build && node -r dotenv/config dist/index.js",
    "test": "node -r dotenv/config ./node_modules/vitest/vitest.mjs run",
    "test:v2": "node -r dotenv/config scripts/generate-insights-v2-test.mjs",
    "test:v2:validate": "node -r dotenv/config scripts/generate-insights-v2-s3-validate.mjs",
    "test:v2:prepass": "node -r dotenv/config scripts/generate-insights-v2-metadata-prepass-s3-test.mjs",
    "eval:offline": "node -r dotenv/config scripts/generate-insights-offline-eval.mjs",
    "test:family-persistence": "node -r dotenv/config scripts/familyPersistence.test.mjs",
    "test:chunks": "node -r dotenv/config scripts/generate-insights-from-chunks-test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1014.0",
    "@aws-sdk/client-dynamodb": "^3.637.0",
    "@aws-sdk/client-s3": "^3.637.0",
    "@aws-sdk/credential-providers": "^3.637.0",
    "@aws-sdk/lib-dynamodb": "^3.637.0",
    "@elastic/elasticsearch": "^8.15.0",
    "@langchain/langgraph": "^0.2.0",
    "@opensearch-project/opensearch": "^3.5.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^4.19.2",
    "openai": "^4.58.2",
    "unstructured-client": "^0.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3",
    "vitest": "^1.6.0"
  }
}
